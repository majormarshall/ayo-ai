# Ayo AI — Environment Variables Template
# Copy this file to .env and fill in as needed

# ── Ollama Settings ────────────────────────────────────────────────────────────
# Default: llama3.2. Other options: mistral, phi3, gemma2, llama3
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# ── Whisper STT ───────────────────────────────────────────────────────────────
# tiny | base | small | medium
WHISPER_MODEL=base

# ── Voice Biometrics ──────────────────────────────────────────────────────────
# Similarity threshold 0.0-1.0. Default 0.82 (82%)
SPEAKER_THRESHOLD=0.82

# ── Wake Word ─────────────────────────────────────────────────────────────────
# Fuzzy match score 0-100. Lower = more sensitive. Default 70
WAKE_MATCH_THRESHOLD=70

# ── Phone (Android ADB) ───────────────────────────────────────────────────────
# Your phone's Wi-Fi IP address
PHONE_IP=
PHONE_PORT=5555

# ── API Server ────────────────────────────────────────────────────────────────
API_PORT=5050
